<?xml version="1.0" encoding="utf-8"?>
<!--
  Dynamic managed instrumentation. Coverage is collected through the CLR instrumentation engine
  profiler instead of by rewriting assemblies, so no memory-mapped probe buffer is created under
  the temporary directory, so the unguarded probe store that crashes the static arm cannot exist.
-->
<Configuration>
  <CodeCoverage>
    <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
    <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
  </CodeCoverage>
</Configuration>
