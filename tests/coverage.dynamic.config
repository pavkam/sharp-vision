<?xml version="1.0" encoding="utf-8"?>
<!--
  Dynamic managed instrumentation. Coverage is collected through the CLR instrumentation engine
  profiler instead of by rewriting assemblies, so no memory-mapped probe buffer is created under
  the temporary directory, so the unguarded probe store that crashes the static arm cannot exist.
-->
<Configuration>
  <CodeCoverage>
    <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
    <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
    <!--
      Only the shipped libraries under src/ count. Example applications and test projects
      (including the shared SharpVision.Test.Shared harness) are excluded by source path at
      collection time, so the per-project Cobertura files, the merged ReportGenerator report, the
      badge, and the Codecov figure all describe the same product surface. The patterns accept
      either path separator because the same file is used on Windows and Unix runners.
    -->
    <Sources>
      <Exclude>
        <Source>.*[/\\]examples[/\\].*</Source>
        <Source>.*[/\\]tests[/\\].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
