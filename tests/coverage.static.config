<?xml version="1.0" encoding="utf-8"?>
<!--
  Static managed instrumentation. Rewrites each assembly on disk and prefixes every basic block
  with a store into a memory-mapped probe buffer under the temporary directory. This is the
  configuration that produces the intermittent AccessViolationException on Linux; it is kept
  only as the control arm of that experiment.
-->
<Configuration>
  <CodeCoverage>
    <UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>
    <EnableDynamicManagedInstrumentation>False</EnableDynamicManagedInstrumentation>
    <EnableStaticManagedInstrumentation>True</EnableStaticManagedInstrumentation>
    <EnableStaticManagedInstrumentationRestore>True</EnableStaticManagedInstrumentationRestore>
    <EnableStaticManagedInstrumentationSafeInitialization>True</EnableStaticManagedInstrumentationSafeInitialization>
    <!--
      Only the shipped libraries under src/ count. Example applications and test projects
      (including the shared SharpVision.Test.Shared harness) are excluded by source path at
      collection time, so the per-project Cobertura files, the merged ReportGenerator report, the
      badge, and the Codecov figure all describe the same product surface. The patterns accept
      either path separator because the same file is used on Windows and Unix runners.
    -->
    <Sources>
      <Exclude>
        <Source>.*[/\\]examples[/\\].*</Source>
        <Source>.*[/\\]tests[/\\].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
