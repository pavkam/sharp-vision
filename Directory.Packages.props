<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Derived, never a literal. SharpVision.FigletFonts consumes the core as a package rather
         than a project reference, and NuGet resolves a floor range to the lowest satisfying
         version across all sources - so a literal floor that falls behind SharpVisionVersion
         silently builds, packs, and consumer-tests the font package against whatever older core
         is on nuget.org, while the freshly packed one in the bootstrap feed goes unused.
         SharpVision.Terminal and SharpVision.FigletFonts each publish under their own,
         independent version (see Directory.Build.props); only this one floor - the dependency
         FigletFonts actually consumes - needs to track SharpVision's own version. -->
    <PackageVersion Include="SharpVision" Version="[$(SharpVisionVersion),)" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Pinned, not stale: every Microsoft.Testing.Extensions.CodeCoverage release above 18.0.6
         depends on Microsoft.Testing.Platform 2.x, but xunit.v3's latest STABLE release (3.2.2)
         installs xunit.v3.mtp-v1 - hard-pinned to the Testing.Platform 1.x line. Testing.Platform
         2.x support only exists in xunit.v3 4.0.0's prerelease line as of this writing. Bumping
         this package alone throws TypeLoadException: Could not load type
         'Microsoft.Testing.Platform.Extensions.TestHost.IDataConsumer' at test-host startup
         (verified locally). Re-check this pairing whenever xunit.v3 ships a stable mtp-v2 release. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.6" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Verify.XunitV3" Version="31.28.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
