{
  "name": "sharpvision-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation quality tooling for SharpVision.",
  "scripts": {
    "check:unicode": "node scripts/generate-unicode-data.mjs --check",
    "check:figlet": "node scripts/audit-figlet-fonts.mjs --source ${FIGLET_FONT_SOURCE} --commit 417429ef36ab039cbf192a4424c60aa23fc32de8 --output extern/figlet/fonts.manifest.json --check",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "generate:unicode": "node scripts/generate-unicode-data.mjs",
    "lint:csharp-types": "node scripts/validate-csharp-types.mjs",
    "lint:extern": "node scripts/validate-extern.mjs",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.worktrees\"",
    "lint:links": "node scripts/validate-doc-links.mjs",
    "refresh:unicode": "node scripts/generate-unicode-data.mjs --refresh",
    "test:docs": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.0",
    "prettier": "3.9.5"
  },
  "engines": {
    "node": ">=22"
  }
}
