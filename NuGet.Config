<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources live here, not on any dotnet CLI command line or shell environment variable, so
  that no shell ever tokenizes the nuget.org URL. On Windows CI, both Git-for-Windows bash and
  make's nested MSYS2 shell rewrite POSIX-looking argv/env-var values into local Windows paths
  when launching a native child process like dotnet.exe (every MSYS exclusion knob tried:
  MSYS_NO_PATHCONV, MSYS2_ARG_CONV_EXCL, MSYS2_ENV_CONV_EXCL, still left the URL mangled into
  something like "D:\...\https:\api.nuget.org\v3\index.json"). NuGet reads this file directly, so
  the URL never passes through a shell at all.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bootstrap" value="artifacts/bootstrap-packages" />
  </packageSources>
</configuration>
