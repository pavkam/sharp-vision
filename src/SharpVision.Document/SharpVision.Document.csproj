<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpVision</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision.Document</PackageId>
    <Title>SharpVision Document</Title>
    <PackageTags>terminal;terminal-ui;tui;console;document;markdown;commonmark</PackageTags>
    <Description>Rich flowing documents, interactive forms, and Markdown for SharpVision.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision.Document 1.4.0-beta.1 prerelease with cross-content selection, semantic-color document defaults, closed-vocabulary theming, and Markdown reader fixes for underscore strong emphasis, bracketed link labels, and the thematic-break indent limit.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpVision\SharpVision.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

</Project>
