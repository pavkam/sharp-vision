<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpVision</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision.Document</PackageId>
    <Title>SharpVision Document</Title>
    <PackageTags>terminal;terminal-ui;tui;console;document;markdown;commonmark</PackageTags>
    <Description>Rich flowing documents, interactive forms, and Markdown for SharpVision.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision.Document 1.5.0-beta.1 prerelease: version-aligned with the other SharpVision packages; the only change since 1.4.0-beta.1 is the internal reference update from the Document control naming and visibility unification (SharpVision.Controls.Documents renamed to SharpVision.Controls.Document).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpVision\SharpVision.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

</Project>
