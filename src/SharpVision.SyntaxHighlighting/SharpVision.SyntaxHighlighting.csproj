<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SharpVision</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision.SyntaxHighlighting</PackageId>
    <Title>SharpVision Syntax Highlighting</Title>
    <PackageTags>terminal;terminal-ui;tui;console;syntax-highlighting;code;kate</PackageTags>
    <Description>Read-only, selectable, foldable syntax-highlighted code display for SharpVision, driven by Kate/KSyntaxHighlighting-format definitions.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision.SyntaxHighlighting 1.6.0-beta.5 prerelease: version-aligned with the other SharpVision packages; no functional changes since 1.6.0-beta.2, in which CodeView selection started to take part in the application-wide single text selection introduced in SharpVision 1.6.0-beta.2: selecting in a CodeView collapses ranges held by other owners and vice versa. Since 1.6.0-beta.1 CodeView derives from the core ScrollableCompositeControlBase and uses the shared ProjectionSurface, scroll-bridge, PropertyChanged, attachment, and glyph-resolution seams introduced in SharpVision 1.6.0-beta.1, replacing its own CodeViewContent and hand-rolled copies; no public behavior change.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations"/>
    <PackageReference Include="PCRE.NET"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpVision\SharpVision.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Syntax/*.xml">
      <LogicalName>SharpVision.SyntaxHighlighting.Resources.Syntax.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/syntax.manifest.json" LogicalName="SharpVision.SyntaxHighlighting.Resources.syntax.manifest.json"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/"/>
    <None Include="Licenses/*.txt" Pack="true" PackagePath="licenses/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

</Project>
