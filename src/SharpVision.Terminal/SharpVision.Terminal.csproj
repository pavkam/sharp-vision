<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision.Terminal</PackageId>
    <Title>SharpVision.Terminal</Title>
    <PackageTags>terminal;protocols;unicode;rendering;console;ansi;vt</PackageTags>
    <Description>Low-level .NET 10 terminal foundation with incremental protocol parsing, capability detection, Unicode cell geometry, input decoding, frame buffers, damage tracking, and deterministic output.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision.Terminal 1.6.0-beta.7 prerelease: version-aligned with the other SharpVision packages; no functional changes since 1.6.0-beta.1, which added job control (SIGTSTP suspend with terminal restore, SIGCONT re-enter and repaint), negotiates DEC private mode 2027 for grapheme-cluster width, and adds a raw-escape binding tier for non-ECMA-48 keys. Protocol and host fixes cover eager-wrap terminals (bottom-right cell skip, scroll-reuse disable, xenl for Windows VT), terminal-title push and restore as one atomic leased step, DA1 written last so its reply fences every earlier probe, direct-color program synthesis so true color reaches the wire, color depth treated as an evidence lattice, xterm-compatible recognition beyond the "xterm" substring, architecture-specific TIOCGWINSZ/ISIG/termios layout, SUSP disabled so Ctrl+Z cannot suspend raw mode, flat lone-Escape latency, stalled-paste recovery with literal routed payloads preserved, Kitty functional keys and legacy mouse reports preserved, PaneVisible driven by live outer-terminal focus events, and a UTF-8-aware Windows console host that reads on a pooled thread and flushes its input buffer on restore. See https://github.com/pavkam/sharp-vision/blob/main/docs/protocols/coverage-matrix.md for the implemented protocol surface and fallback behavior.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

</Project>
