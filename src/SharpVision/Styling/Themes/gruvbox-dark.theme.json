{
  "name": "Gruvbox Dark",
  "slug": "gruvbox-dark",
  "colorScheme": "dark",
  "order": 30,
  "author": "Pavel Pertsev",
  "license": "MIT",
  "source": "https://github.com/morhetz/gruvbox",
  "palette": {
    "bg0": "#282828",
    "bg1": "#3c3836",
    "bg2": "#504945",
    "bg3": "#665c54",
    "fg1": "#ebdbb2",
    "gray": "#928374",
    "red": "#fb4934",
    "green": "#b8bb26",
    "yellow": "#fabd2f",
    "blue": "#83a598",
    "orange": "#fe8019",
    "fg0": "#fbf1c7",
    "navy": "#1d2864",
    "olive": "#56491c"
  },
  "colors": {
    "window": "bg0",
    "windowSurface": "bg1",
    "windowText": "fg1",
    "surface": "bg1",
    "surfaceText": "fg1",
    "control": "bg1",
    "controlText": "fg1",
    "controlBorder": "bg3",
    "controlShadow": "bg3",
    "activeControl": "bg2",
    "activeText": "fg0",
    "activeBorder": "fg1",
    "focusedControl": "bg1",
    "focusedText": "fg1",
    "focusedBorder": "fg1",
    "pressedControl": "olive",
    "pressedText": "yellow",
    "pressedBorder": "yellow",
    "selectedControl": "bg2",
    "selectedText": "fg1",
    "disabledControl": "bg1",
    "disabledText": "gray",
    "disabledBorder": "gray",
    "accent": "orange",
    "muted": "gray",
    "hotkey": "yellow",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue"
  },
  "attributes": {
    "normalText": [],
    "activeText": [],
    "focusedText": "bold",
    "pressedText": [],
    "selectedText": [],
    "disabledText": [],
    "border": [],
    "shadow": "dim",
    "hotkey": "underline"
  },
  "styles": {
    "control": {
      "normal": {
        "face": {
          "foreground": "controlText",
          "background": "control",
          "attributes": "normalText"
        },
        "border": {
          "sides": "none",
          "glyphStyle": "rounded",
          "foreground": "controlBorder",
          "background": "control",
          "attributes": "border"
        },
        "shadow": {
          "visible": false,
          "mode": "composite",
          "offset": {
            "x": 0,
            "y": 0
          },
          "glyph": "▓",
          "foreground": "controlShadow",
          "background": "transparent",
          "attributes": "shadow"
        }
      },
      "disabled": {
        "face": {
          "foreground": "disabledText",
          "background": "disabledControl",
          "attributes": "disabledText"
        },
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "input": {
      "normal": {
        "affixGap": 1,
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "heavy"
        }
      },
      "pointerOver": {
        "face": {
          "foreground": "activeText",
          "attributes": "activeText",
          "background": "activeControl"
        },
        "border": {
          "foreground": "activeBorder"
        }
      },
      "focused": {
        "face": {
          "foreground": "focusedText",
          "background": "focusedControl",
          "attributes": "focusedText"
        },
        "border": {
          "foreground": "focusedBorder"
        }
      },
      "pressed": {
        "face": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "pressedText"
        },
        "border": {
          "foreground": "pressedBorder"
        }
      },
      "selected": {
        "face": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "selectedText"
        }
      }
    },
    "container": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    },
    "window": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "windowSurface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        },
        "shadow": {
          "visible": true,
          "mode": "composite",
          "offset": {
            "x": 2,
            "y": 1
          }
        }
      }
    },
    "popup": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "rounded"
        }
      }
    },
    "tooltip": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    },
    "scrollBar": {
      "normal": {
        "chrome": "thin",
        "fill": "line",
        "glyphs": {
          "verticalDecrement": "^",
          "verticalIncrement": "v",
          "horizontalDecrement": "<",
          "horizontalIncrement": ">",
          "blockTrack": ".",
          "blockThumb": "#",
          "horizontalLineTrack": "-",
          "horizontalLineThumb": "=",
          "verticalLineTrack": "|",
          "verticalLineThumb": "#"
        }
      }
    },
    "checkBox": {
      "normal": {
        "markStyle": "brackets",
        "glyphs": {
          "unchecked": ".",
          "checked": "X",
          "indeterminate": "-"
        }
      }
    },
    "radioButton": {
      "normal": {
        "markStyle": "parentheses",
        "glyphs": {
          "unchecked": ".",
          "checked": "*"
        }
      }
    },
    "button": {
      "normal": {
        "padding": {
          "x": 1,
          "y": 0
        }
      }
    },
    "chaseIndicator": {
      "normal": {
        "active": "*",
        "inactive": "."
      }
    },
    "slider": {
      "normal": {
        "fillColor": "accent",
        "trackColor": "muted",
        "thumbColor": "accent"
      }
    },
    "progressBar": {
      "normal": {
        "fillColor": "accent",
        "trackColor": "muted",
        "indeterminateColor": "warning",
        "glyphs": {
          "fill": "#",
          "track": ".",
          "indeterminate": "?"
        }
      }
    },
    "spinner": {
      "normal": {
        "frames": [
          "|",
          "/",
          "-",
          "\\"
        ]
      }
    },
    "sharpVision.document": {
      "normal": {
        "headingFace": {
          "foreground": "accent",
          "attributes": "focusedText"
        },
        "markerFace": {
          "foreground": "accent",
          "attributes": "focusedText"
        },
        "quoteFace": {
          "foreground": "controlText"
        },
        "codeFace": {
          "foreground": "surfaceText",
          "background": "surface"
        },
        "ruleFace": {
          "foreground": "muted"
        },
        "linkFace": {
          "foreground": "info"
        },
        "activeLinkFace": {
          "foreground": "selectedText",
          "background": "selectedControl"
        },
        "disabledLinkFace": {
          "foreground": "disabledText"
        },
        "actionLinkFace": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "focusedText"
        },
        "activeActionLinkFace": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "focusedText"
        },
        "calloutFace": {
          "foreground": "warning"
        },
        "calloutTitleFace": {
          "foreground": "warning",
          "attributes": "focusedText"
        },
        "tableFace": {
          "foreground": "surfaceText",
          "background": "surface"
        },
        "tableHeaderFace": {
          "foreground": "accent",
          "background": "surface",
          "attributes": "focusedText"
        }
      }
    }
  }
}
