{
  "name": "Gruvbox Dark",
  "slug": "gruvbox-dark",
  "colorScheme": "dark",
  "order": 30,
  "author": "Pavel Pertsev",
  "license": "MIT",
  "source": "https://github.com/morhetz/gruvbox",
  "palette": {
    "bg0": "#282828",
    "bg1": "#3c3836",
    "bg2": "#504945",
    "bg3": "#665c54",
    "fg1": "#ebdbb2",
    "gray": "#928374",
    "red": "#fb4934",
    "green": "#b8bb26",
    "yellow": "#fabd2f",
    "blue": "#83a598",
    "orange": "#fe8019"
  },
  "status": {
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue",
    "muted": "gray",
    "hotkey": "yellow"
  },
  "colors": {
    "window": "bg0",
    "windowText": "fg1",
    "surface": "bg1",
    "surfaceText": "fg1",
    "control": "bg1",
    "controlText": "fg1",
    "controlBorder": "bg3",
    "controlShadow": "bg3",
    "activeControl": "bg2",
    "activeText": "fg1",
    "activeBorder": "fg1",
    "focusedControl": "#323345",
    "focusedText": "orange",
    "focusedBorder": "orange",
    "pressedControl": "#4b4227",
    "pressedText": "yellow",
    "pressedBorder": "yellow",
    "selectedControl": "bg2",
    "selectedText": "fg1",
    "disabledControl": "bg1",
    "disabledText": "gray",
    "disabledBorder": "gray",
    "accent": "orange",
    "muted": "gray",
    "hotkey": "yellow",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue"
  },
  "attributes": {
    "normalText": [],
    "activeText": [],
    "focusedText": "bold",
    "pressedText": [],
    "selectedText": [],
    "disabledText": [],
    "border": [],
    "shadow": "dim",
    "hotkey": "underline"
  },
  "styles": {
    "control": {
      "normal": {
        "face": {
          "foreground": "controlText",
          "background": "control",
          "attributes": "normalText"
        },
        "border": {
          "sides": "none",
          "glyphStyle": "rounded",
          "foreground": "controlBorder",
          "background": "control",
          "attributes": "border"
        },
        "shadow": {
          "visible": false,
          "mode": "composite",
          "offset": {
            "x": 0,
            "y": 0
          },
          "glyph": "▓",
          "foreground": "controlShadow",
          "background": "transparent",
          "attributes": "shadow"
        }
      },
      "pointerOver": {
        "face": {
          "foreground": "activeText",
          "attributes": "activeText"
        },
        "border": {
          "foreground": "activeBorder"
        }
      },
      "focused": {
        "face": {
          "foreground": "focusedText",
          "background": "focusedControl",
          "attributes": "focusedText"
        },
        "border": {
          "foreground": "focusedBorder"
        }
      },
      "pressed": {
        "face": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "pressedText"
        },
        "border": {
          "foreground": "pressedBorder"
        }
      },
      "selected": {
        "face": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "selectedText"
        }
      },
      "disabled": {
        "face": {
          "foreground": "disabledText",
          "background": "disabledControl",
          "attributes": "disabledText"
        },
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "input": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "heavy"
        }
      },
      "pointerOver": {
        "face": {
          "background": "activeControl"
        }
      }
    },
    "container": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    },
    "window": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        },
        "shadow": {
          "visible": true,
          "mode": "composite",
          "offset": {
            "x": 2,
            "y": 1
          }
        }
      }
    },
    "popup": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "rounded"
        }
      }
    }
  }
}
