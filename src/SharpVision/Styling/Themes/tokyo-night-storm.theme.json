{
  "name": "Tokyo Night Storm",
  "slug": "tokyo-night-storm",
  "colorScheme": "dark",
  "order": 11,
  "author": "Folke Lemaitre",
  "license": "MIT",
  "source": "https://github.com/folke/tokyonight.nvim",
  "palette": {
    "bg": "#24283b",
    "bg-highlight": "#292e42",
    "fg": "#c0caf5",
    "comment": "#565f89",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "green": "#9ece6a",
    "magenta": "#bb9af7",
    "red": "#f7768e",
    "yellow": "#e0af68",
    "orange": "#ff9e64",
    "selection": "#2e3c64"
  },
  "status": {
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue",
    "muted": "comment",
    "hotkey": "yellow"
  },
  "colors": {
    "window": "bg",
    "windowText": "fg",
    "surface": "bg-highlight",
    "surfaceText": "fg",
    "control": "bg-highlight",
    "controlText": "fg",
    "controlBorder": "comment",
    "controlShadow": "comment",
    "activeControl": "#363b4f",
    "activeText": "fg",
    "activeBorder": "fg",
    "focusedControl": "#1f2951",
    "focusedText": "blue",
    "focusedBorder": "blue",
    "pressedControl": "#383833",
    "pressedText": "yellow",
    "pressedBorder": "yellow",
    "selectedControl": "selection",
    "selectedText": "fg",
    "disabledControl": "bg-highlight",
    "disabledText": "comment",
    "disabledBorder": "comment",
    "accent": "blue",
    "muted": "comment",
    "hotkey": "yellow",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue"
  },
  "attributes": {
    "normalText": [],
    "activeText": [],
    "focusedText": "bold",
    "pressedText": [],
    "selectedText": [],
    "disabledText": [],
    "border": [],
    "shadow": "dim",
    "hotkey": "underline"
  },
  "styles": {
    "control": {
      "normal": {
        "face": {
          "foreground": "controlText",
          "background": "control",
          "attributes": "normalText"
        },
        "border": {
          "sides": "none",
          "glyphStyle": "rounded",
          "foreground": "controlBorder",
          "background": "control",
          "attributes": "border"
        },
        "shadow": {
          "visible": false,
          "mode": "composite",
          "offset": {
            "x": 0,
            "y": 0
          },
          "glyph": "▓",
          "foreground": "controlShadow",
          "background": "transparent",
          "attributes": "shadow"
        }
      },
      "pointerOver": {
        "face": {
          "foreground": "activeText",
          "attributes": "activeText"
        },
        "border": {
          "foreground": "activeBorder"
        }
      },
      "focused": {
        "face": {
          "foreground": "focusedText",
          "background": "focusedControl",
          "attributes": "focusedText"
        },
        "border": {
          "foreground": "focusedBorder"
        }
      },
      "pressed": {
        "face": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "pressedText"
        },
        "border": {
          "foreground": "pressedBorder"
        }
      },
      "selected": {
        "face": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "selectedText"
        }
      },
      "disabled": {
        "face": {
          "foreground": "disabledText",
          "background": "disabledControl",
          "attributes": "disabledText"
        },
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "input": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "heavy"
        }
      },
      "pointerOver": {
        "face": {
          "background": "activeControl"
        }
      }
    },
    "container": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    },
    "window": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        },
        "shadow": {
          "visible": true,
          "mode": "composite",
          "offset": {
            "x": 2,
            "y": 1
          }
        }
      }
    },
    "popup": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "rounded"
        }
      }
    }
  }
}
