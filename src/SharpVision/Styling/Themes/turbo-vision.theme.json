{
  "name": "Turbo Vision",
  "slug": "turbo-vision",
  "colorScheme": "dark",
  "order": 5,
  "author": "Borland International / magiblot",
  "license": "MIT",
  "source": "https://github.com/magiblot/tvision/blob/master/include/tvision/app.h",
  "glyphs": "lines",
  "palette": {
    "black": "#000000",
    "blue": "#0000aa",
    "green": "#00aa00",
    "cyan": "#00aaaa",
    "red": "#aa0000",
    "magenta": "#aa00aa",
    "brown": "#aa5500",
    "lightGray": "#aaaaaa",
    "darkGray": "#555555",
    "brightBlue": "#5555ff",
    "brightGreen": "#55ff55",
    "brightCyan": "#55ffff",
    "brightRed": "#ff5555",
    "brightMagenta": "#ff55ff",
    "yellow": "#ffff55",
    "white": "#ffffff"
  },
  "colors": {
    "window": "blue",
    "windowSurface": "lightGray",
    "windowText": "black",
    "surface": "lightGray",
    "surfaceText": "black",
    "control": "lightGray",
    "controlText": "black",
    "controlBorder": "white",
    "controlShadow": "black",
    "reliefHighlight": "white",
    "reliefShade": "black",
    "activeControl": "cyan",
    "activeText": "white",
    "activeBorder": "brightCyan",
    "focusedControl": "lightGray",
    "focusedText": "black",
    "focusedBorder": "brightCyan",
    "pressedControl": "green",
    "pressedText": "yellow",
    "pressedBorder": "yellow",
    "selectedControl": "cyan",
    "selectedText": "black",
    "disabledControl": "lightGray",
    "disabledText": "darkGray",
    "disabledBorder": "darkGray",
    "accent": "cyan",
    "muted": "darkGray",
    "hotkey": "red",
    "error": "brightRed",
    "warning": "yellow",
    "success": "brightGreen",
    "info": "brightCyan",
    "red": "red",
    "green": "green",
    "yellow": "yellow",
    "blue": "brightBlue",
    "magenta": "brightMagenta",
    "cyan": "brightCyan"
  },
  "attributes": {
    "normalText": [],
    "activeText": [],
    "focusedText": "bold",
    "pressedText": [],
    "selectedText": [],
    "disabledText": [],
    "border": [],
    "shadow": "dim",
    "hotkey": "underline"
  },
  "styles": {
    "control": {
      "normal": {
        "face": {
          "foreground": "controlText",
          "background": "control",
          "attributes": "normalText"
        },
        "border": {
          "sides": "none",
          "glyphStyle": "light",
          "foreground": "controlBorder",
          "background": "control",
          "attributes": "border"
        },
        "shadow": {
          "visible": false,
          "mode": "composite",
          "offset": {
            "x": 0,
            "y": 0
          },
          "glyph": "▓",
          "foreground": "controlShadow",
          "background": "transparent",
          "attributes": "shadow"
        }
      },
      "disabled": {
        "face": {
          "foreground": "disabledText",
          "background": "disabledControl",
          "attributes": "disabledText"
        },
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "input": {
      "normal": {
        "affixGap": 1,
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      },
      "pointerOver": {
        "face": {
          "foreground": "activeText",
          "attributes": "activeText",
          "background": "activeControl"
        },
        "border": {
          "foreground": "activeBorder"
        }
      },
      "focused": {
        "face": {
          "foreground": "focusedText",
          "background": "focusedControl",
          "attributes": "focusedText"
        },
        "border": {
          "foreground": "focusedBorder"
        }
      },
      "pressed": {
        "face": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "pressedText"
        },
        "border": {
          "foreground": "pressedBorder"
        }
      },
      "selected": {
        "face": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "selectedText"
        }
      },
      "disabled": {
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "container": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light",
          "relief": "sunken"
        }
      }
    },
    "window": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "windowSurface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        },
        "shadow": {
          "visible": true,
          "mode": "composite",
          "offset": {
            "x": 2,
            "y": 1
          }
        }
      },
      "focusWithin": {
        "border": {
          "foreground": "activeBorder"
        }
      }
    },
    "popup": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        }
      }
    },
    "tooltip": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    }
  }
}
