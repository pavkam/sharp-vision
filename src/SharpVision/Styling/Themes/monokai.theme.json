{
  "name": "Monokai",
  "slug": "monokai",
  "colorScheme": "dark",
  "order": 60,
  "author": "Wimer Hazenberg",
  "license": "MIT",
  "source": "https://www.monokai.nl",
  "glyphs": "shades",
  "palette": {
    "bg": "#272822",
    "raised": "#3e3d32",
    "selection": "#49483e",
    "fg": "#f8f8f2",
    "comment": "#75715e",
    "barSurface": "#6b6756",
    "hotkeyText": "#fff59d",
    "pink": "#f92672",
    "orange": "#fd971f",
    "yellow": "#e6db74",
    "green": "#a6e22e",
    "cyan": "#66d9ef",
    "purple": "#ae81ff",
    "ice": "#d9f5fb",
    "navy": "#1b2c66",
    "olive": "#524a1e",
    "mint": "#a1efe4"
  },
  "colors": {
    "window": "bg",
    "windowSurface": "raised",
    "windowText": "fg",
    "surface": "raised",
    "surfaceText": "fg",
    "bar": "barSurface",
    "control": "raised",
    "controlText": "fg",
    "controlBorder": "comment",
    "controlShadow": "comment",
    "reliefHighlight": "fg",
    "reliefShade": "comment",
    "activeControl": "selection",
    "activeText": "ice",
    "activeBorder": "fg",
    "focusedControl": "raised",
    "focusedText": "fg",
    "focusedBorder": "fg",
    "pressedControl": "olive",
    "pressedText": "orange",
    "pressedBorder": "orange",
    "selectedControl": "selection",
    "selectedText": "fg",
    "disabledControl": "raised",
    "disabledText": "comment",
    "disabledBorder": "comment",
    "accent": "pink",
    "muted": "comment",
    "hotkey": "hotkeyText",
    "error": "pink",
    "warning": "orange",
    "success": "green",
    "info": "cyan",
    "red": "pink",
    "green": "green",
    "yellow": "yellow",
    "blue": "cyan",
    "magenta": "purple",
    "cyan": "mint"
  },
  "attributes": {
    "normalText": [],
    "activeText": [],
    "focusedText": "bold",
    "pressedText": [],
    "selectedText": [],
    "disabledText": [],
    "border": [],
    "shadow": "dim",
    "hotkey": "underline"
  },
  "styles": {
    "control": {
      "normal": {
        "face": {
          "foreground": "controlText",
          "background": "control",
          "attributes": "normalText"
        },
        "border": {
          "sides": "none",
          "glyphStyle": "rounded",
          "foreground": "controlBorder",
          "background": "control",
          "attributes": "border"
        },
        "shadow": {
          "visible": false,
          "mode": "composite",
          "offset": {
            "x": 0,
            "y": 0
          },
          "glyph": "▓",
          "foreground": "controlShadow",
          "background": "transparent",
          "attributes": "shadow"
        }
      },
      "disabled": {
        "face": {
          "foreground": "disabledText",
          "background": "disabledControl",
          "attributes": "disabledText"
        },
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "input": {
      "normal": {
        "affixGap": 1,
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "heavy"
        }
      },
      "pointerOver": {
        "face": {
          "foreground": "activeText",
          "attributes": "activeText",
          "background": "activeControl"
        },
        "border": {
          "foreground": "activeBorder"
        }
      },
      "focused": {
        "face": {
          "foreground": "focusedText",
          "background": "focusedControl",
          "attributes": "focusedText"
        },
        "border": {
          "foreground": "focusedBorder"
        }
      },
      "pressed": {
        "face": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "pressedText"
        },
        "border": {
          "foreground": "pressedBorder"
        }
      },
      "selected": {
        "face": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "selectedText"
        }
      }
    },
    "container": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    },
    "window": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "windowSurface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        },
        "shadow": {
          "visible": true,
          "mode": "composite",
          "offset": {
            "x": 2,
            "y": 1
          }
        }
      }
    },
    "popup": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "rounded"
        }
      }
    },
    "tooltip": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    }
  }
}
