{
  "name": "One Dark",
  "slug": "one-dark",
  "colorScheme": "dark",
  "order": 80,
  "author": "Josh Dick",
  "license": "MIT",
  "source": "https://github.com/joshdick/onedark.vim",
  "glyphs": "blocks",
  "palette": {
    "bg": "#282c34",
    "cursor-grey": "#2c323c",
    "visual-grey": "#3e4452",
    "gutter-grey": "#4b5263",
    "comment-grey": "#5c6370",
    "fg": "#abb2bf",
    "red": "#e06c75",
    "green": "#98c379",
    "yellow": "#e5c07b",
    "orange": "#d19a66",
    "blue": "#61afef",
    "purple": "#c678dd",
    "cyan": "#56b6c2",
    "ghost-grey": "#d7dae0",
    "navy": "#17285c",
    "olive": "#3b3c2d"
  },
  "colors": {
    "window": "bg",
    "windowSurface": "cursor-grey",
    "windowText": "fg",
    "surface": "cursor-grey",
    "surfaceText": "fg",
    "bar": "navy",
    "control": "cursor-grey",
    "controlText": "fg",
    "controlBorder": "gutter-grey",
    "controlShadow": "gutter-grey",
    "reliefHighlight": "fg",
    "reliefShade": "gutter-grey",
    "activeControl": "visual-grey",
    "activeText": "ghost-grey",
    "activeBorder": "fg",
    "focusedControl": "cursor-grey",
    "focusedText": "fg",
    "focusedBorder": "fg",
    "pressedControl": "olive",
    "pressedText": "orange",
    "pressedBorder": "orange",
    "selectedControl": "visual-grey",
    "selectedText": "fg",
    "disabledControl": "cursor-grey",
    "disabledText": "comment-grey",
    "disabledBorder": "comment-grey",
    "accent": "blue",
    "muted": "comment-grey",
    "hotkey": "yellow",
    "error": "red",
    "warning": "orange",
    "success": "green",
    "info": "cyan",
    "red": "red",
    "green": "green",
    "yellow": "yellow",
    "blue": "blue",
    "magenta": "purple",
    "cyan": "cyan"
  },
  "attributes": {
    "normalText": [],
    "activeText": [],
    "focusedText": "bold",
    "pressedText": [],
    "selectedText": [],
    "disabledText": [],
    "border": [],
    "shadow": "dim",
    "hotkey": "underline"
  },
  "styles": {
    "control": {
      "normal": {
        "face": {
          "foreground": "controlText",
          "background": "control",
          "attributes": "normalText"
        },
        "border": {
          "sides": "none",
          "glyphStyle": "rounded",
          "foreground": "controlBorder",
          "background": "control",
          "attributes": "border"
        },
        "shadow": {
          "visible": false,
          "mode": "composite",
          "offset": {
            "x": 0,
            "y": 0
          },
          "glyph": "▓",
          "foreground": "controlShadow",
          "background": "transparent",
          "attributes": "shadow"
        }
      },
      "disabled": {
        "face": {
          "foreground": "disabledText",
          "background": "disabledControl",
          "attributes": "disabledText"
        },
        "border": {
          "foreground": "disabledBorder"
        }
      }
    },
    "input": {
      "normal": {
        "affixGap": 1,
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "heavy"
        }
      },
      "pointerOver": {
        "face": {
          "foreground": "activeText",
          "attributes": "activeText",
          "background": "activeControl"
        },
        "border": {
          "foreground": "activeBorder"
        }
      },
      "focused": {
        "face": {
          "foreground": "focusedText",
          "background": "focusedControl",
          "attributes": "focusedText"
        },
        "border": {
          "foreground": "focusedBorder"
        }
      },
      "pressed": {
        "face": {
          "foreground": "pressedText",
          "background": "pressedControl",
          "attributes": "pressedText"
        },
        "border": {
          "foreground": "pressedBorder"
        }
      },
      "selected": {
        "face": {
          "foreground": "selectedText",
          "background": "selectedControl",
          "attributes": "selectedText"
        }
      }
    },
    "container": {
      "normal": {
        "face": {
          "background": "surface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    },
    "window": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "windowSurface"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "paired"
        },
        "shadow": {
          "visible": true,
          "mode": "composite",
          "offset": {
            "x": 2,
            "y": 1
          }
        }
      }
    },
    "popup": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "rounded"
        }
      }
    },
    "tooltip": {
      "normal": {
        "face": {
          "foreground": "windowText",
          "background": "window"
        },
        "border": {
          "sides": "all",
          "glyphStyle": "light"
        }
      }
    }
  }
}
