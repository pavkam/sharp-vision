<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SharpVision.Terminal\SharpVision.Terminal.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Styling/Themes/*.theme.json">
      <LogicalName>SharpVision.Styling.Themes.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision</PackageId>
    <Title>SharpVision</Title>
    <PackageTags>terminal;terminal-ui;tui;console;ui;unicode;cross-platform;retained-mode</PackageTags>
    <Description>Retained-mode terminal UI framework for .NET 10 with mutable controls, deterministic layout and input, Unicode-aware rendering, styling, dialogs, windows, and managed console hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision 1.3.0-beta.1 prerelease: the theme styles vocabulary is closed to the six role sections (leaf-control and vendor-dotted styles keys are now rejected), with chromatic semantic colors, theme-level glyph families, published derived interaction style sets, an expanded ChartStyle, a selectable-text and clipboard-copy foundation (ISelectableTextSource, ISelectableTextViewport, IClipboardCopySource, and related interfaces), and a ControlBase.ResolveAppearance theme preview. See https://github.com/pavkam/sharp-vision/blob/main/docs/index.md for API contracts, examples, and current support.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

</Project>
