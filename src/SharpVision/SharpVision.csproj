<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SharpVision.Terminal\SharpVision.Terminal.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Styling/Themes/*.theme.json">
      <LogicalName>SharpVision.Styling.Themes.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision</PackageId>
    <Title>SharpVision</Title>
    <PackageTags>terminal;terminal-ui;tui;console;ui;unicode;cross-platform;retained-mode</PackageTags>
    <Description>Retained-mode terminal UI framework for .NET 10 with mutable controls, deterministic layout and input, Unicode-aware rendering, styling, dialogs, windows, and managed console hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision 1.5.0-beta.1 prerelease: a broad correctness-hardening pass across controls (activation-handler resilience for bound commands, appearance-change comparisons, navigation and focus), runtime and hosting (dispatcher timer generation scoping, stopping-token cancellation guarantees, out-of-band render flush gating during shutdown), styling (theme attribute-name resolution), and grapheme/text classification, alongside further work on the Document control's naming, visibility, and selection foundation (TextSelectionMap/TextSelectionGlyph/TextSelectionSource). See https://github.com/pavkam/sharp-vision/blob/main/docs/index.md for API contracts, examples, and current support.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

</Project>
