<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SharpVision.Terminal\SharpVision.Terminal.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Styling/Themes/*.theme.json">
      <LogicalName>SharpVision.Styling.Themes.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <PackageId>SharpVision</PackageId>
    <Title>SharpVision</Title>
    <PackageTags>terminal;terminal-ui;tui;console;ui;unicode;cross-platform;retained-mode</PackageTags>
    <Description>Retained-mode terminal UI framework for .NET 10 with mutable controls, deterministic layout and input, Unicode-aware rendering, styling, dialogs, windows, and managed console hosting.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>SharpVision 1.6.0-beta.1 prerelease: opens the control-authoring surface so a foreign control family can be built on the same seams the shipped controls use - new authoring bases (ScrollableCompositeControlBase, NumericInputBase, TemporalInputBase, ChartControlBase, FileDialogBase, ItemCollection&lt;TItem&gt;) and ControlBase capabilities for press and drag gestures, owned drop-down popups, modal sessions, owner-bound timers (ControlTimer), and glyph resolution, with the ItemsControl, InputBase, Container, and FloatingSurfaceBase pipeline hooks published rather than internal. Also fixes layout and scrolling correctness (Overlay navigation-slot walking, Container popup and BringIntoView arrangement coherence, monotone scrollbar reservations, ArrangeUniformRows offset remapping, Percent/Star lengths rebased against Viewport), selection integrity (spurious TabControl/Table events, in-flight proposals invalidated on batched structural changes), word-wrap trailing whitespace with O(log n) word navigation, and culture-invariant geometry and layout formatting. See https://github.com/pavkam/sharp-vision/blob/main/docs/index.md for API contracts, examples, and current support.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="../../media/logo.png" Pack="true" PackagePath="icon.png"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>

</Project>
