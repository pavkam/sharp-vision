* text=auto

*.cs text eol=lf
*.csproj text eol=lf
*.md text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.targets text eol=lf
*.verified.txt text eol=lf working-tree-encoding=UTF-8
*.verified.xml text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8
*.verified.bin binary
*.bin binary

# extern/unicode holds byte-exact pinned Unicode Character Database sources,
# hashed and compared verbatim by scripts/generate-unicode-data.mjs. Without
# a forced LF checkout, Windows converts them to CRLF on clone, which no
# longer matches the SHA-256 pinned against the original LF source (#257).
extern/unicode/**/*.txt text eol=lf working-tree-encoding=UTF-8

# .flf FIGlet fonts are embedded as manifest resources and read back as raw
# bytes, pinned to an exact length and SHA-256 in fonts.manifest.json - not
# text content. A CRLF checkout on Windows adds a byte per line, breaking
# both the length and hash check (#258); binary disables any line-ending or
# encoding translation, on every platform.
*.flf binary

# The audited KDE syntax-highlighting definitions are likewise embedded as
# manifest resources and read back as raw bytes, pinned to an exact length
# and SHA-256 in syntax.manifest.json (SyntaxDefinitionCatalog.LoadEmbeddedDefinition).
# Falling under only the blanket "* text=auto" above left them exposed to the
# same Windows CRLF-on-checkout inflation as the unpinned files described
# above, growing every embedded definition by one byte per line and failing
# the length check for all of them, not just the ones a short CI log happens
# to print first. Unlike the FIGlet fonts these are genuine UTF-8 XML text
# meant to stay diffable, so pin the working tree to LF instead of going
# binary.
src/SharpVision.SyntaxHighlighting/Resources/Syntax/*.xml text eol=lf working-tree-encoding=UTF-8

**/Snapshots/** linguist-generated=true
